# ==============================================================================
# Allen + Clarke Business Development Opportunity Radar - Environment Config
# ==============================================================================

# --- OpenRouter Configuration (Recommended for Live Multi-Agent Demos) ---
# Obtain an API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# Default model to use with OpenRouter (Examples: anthropic/claude-3.5-sonnet, openai/gpt-4o-mini, google/gemini-2.5-flash)
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Optional custom base URL (defaults to https://openrouter.ai/api/v1)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1


# --- Alternative: Direct OpenAI Configuration ---
# OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_MODEL=gpt-4o-mini


# --- Database & Output Options ---
# RADAR_DB_PATH=radar.db
# REPORTS_OUTPUT_DIR=reports
